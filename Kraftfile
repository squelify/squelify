# @see: https://unikraft.org/docs/cli/reference/kraftfile/v0.6

spec: v0.6

name: squelify

runtime: node:20

# # Additional third-party libraries
# libraries:
#   musl: stable

labels:
    cloud.unikraft.v1.instances/scale_to_zero.policy: "on"
    cloud.unikraft.v1.instances/scale_to_zero.stateful: "false"
