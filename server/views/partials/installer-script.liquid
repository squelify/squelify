<script>
  function togglePassword() {
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eye-icon');

    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeIcon.innerHTML = `
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
      `;
    } else {
      passwordInput.type = 'password';
      eyeIcon.innerHTML = `
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      `;
    }
  }

  const form = document.querySelector('form');
  const submitBtn = document.getElementById('submitBtn');
  const requiredInputs = form.querySelectorAll('input[required]');

  function showError(input) {
    // Only show error if field has been touched
    if (!input.dataset.touched) return;

    const errorElement = input.parentElement.querySelector('.error-message');
    if (!errorElement) return;

    if (!input.validity.valid) {
      let message = input.title;

      if (input.validity.valueMissing) {
        message = 'This field is required';
      } else if (input.validity.tooShort) {
        message = `Minimum ${input.minLength} characters required`;
      } else if (input.validity.tooLong) {
        message = `Maximum ${input.maxLength} characters allowed`;
      } else if (input.validity.patternMismatch) {
        message = input.title;
      }

      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    } else {
      errorElement.textContent = '';
      errorElement.classList.add('hidden');
    }
  }

  function validateForm(focusFirstInvalid = false) {
    let isValid = true;
    let firstInvalid = null;

    requiredInputs.forEach(input => {
      const isInputValid = input.value && input.checkValidity();
      showError(input);

      if (!isInputValid && !firstInvalid) {
        firstInvalid = input;
      }
      isValid = isValid && isInputValid;
    });

    submitBtn.disabled = !isValid;

    if (focusFirstInvalid && firstInvalid) {
      firstInvalid.focus();
      firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // Mark field as touched on blur
  requiredInputs.forEach(input => {
    input.addEventListener('input', () => validateForm(false));
    input.addEventListener('blur', () => {
      input.dataset.touched = 'true';
      validateForm(false);
    });
  });

  // Show all errors on form submit
  form.addEventListener('submit', (e) => {
    requiredInputs.forEach(input => {
      input.dataset.touched = 'true';
    });

    if (!form.checkValidity()) {
      e.preventDefault();
      validateForm(true);
    }
  });

  // Initial validation without showing errors
  validateForm(false);
</script>
