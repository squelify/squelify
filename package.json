{
    "name": "squelify",
    "version": "0.0.0",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/squelify/squelify.git"
    },
    "bugs": {
        "url": "https://github.com/squelify/squelify/issues"
    },
    "homepage": "https://github.com/squelify/squelify#readme",
    "config": {
        "image": "ghcr.io/squelify/squelify"
    },
    "scripts": {
        "build": "nitro build",
        "prepare": "nitro prepare",
        "dev": "NODE_ENV=development nitro dev --port 3278",
        "start": "PORT=3278 node --env-file .env .output/server/index.mjs",
        "docker:build": "docker build -f Dockerfile . -t $npm_package_config_image:latest -t $npm_package_config_image:$npm_package_version",
        "docker:push": "docker push $npm_package_config_image:latest && docker push $npm_package_config_image:$npm_package_version",
        "docker:run": "pnpm --silent run dockerx --name $npm_package_name $npm_package_config_image:$npm_package_version",
        "docker:shell": "pnpm --silent run dockerx --entrypoint /bin/sh $npm_package_config_image:$npm_package_version",
        "docker:images": "docker image list --filter reference=$npm_package_config_image:*",
        "dockerx": "docker run --network=host --rm -it --env-file .env -v $(pwd)/_data:/srv/_data",
        "compose:cleanup": "docker compose -f .config/compose.yaml down --remove-orphans --volumes",
        "compose:up": "docker compose -f .config/compose.yaml up --detach --remove-orphans",
        "compose:down": "docker compose -f .config/compose.yaml down --remove-orphans",
        "kraft:build": "kraft build -K Kraftfile . --plat qemu",
        "kraft:run": "pnpm --silent run kraftx --rootfs .unikraft/build/initramfs-x86_64.cpio --plat qemu -M 256Mi",
        "kraft:deploy": "kraft cl deploy --metro sin0 -p 443:3278 . -M 256Mi -n $npm_package_name",
        "kraftx": "kraft run --rm -p 3278:3278 -n $npm_package_name -v $(pwd)/_data:/srv/_data",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "update-deps": "npm-check-updates --configFileName .config/ncurc.json",
        "cleanup": "pnpm --stream --parallel --color \"/cleanup:(?!deps)/\"",
        "cleanup:dev": "pnpm dlx rimraf .{output,client,build,data,dist,nitro}",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules tests-results",
        "changelog-full": "git-cliff -o CHANGELOG.md -c .config/cliff-full.toml",
        "squelify": "tsx -r dotenv/config server/cmd/index.ts",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.9.1",
        "@libsql/kysely-libsql": "^0.4.1",
        "@nanostores/persistent": "^0.10.2",
        "@nanostores/react": "^0.8.0",
        "@noble/hashes": "^1.5.0",
        "@radix-ui/react-accordion": "^1.2.1",
        "@radix-ui/react-alert-dialog": "^1.1.2",
        "@radix-ui/react-aspect-ratio": "^1.1.0",
        "@radix-ui/react-avatar": "^1.1.1",
        "@radix-ui/react-checkbox": "^1.1.2",
        "@radix-ui/react-collapsible": "^1.1.1",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-dropdown-menu": "^2.1.2",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-popover": "^1.1.2",
        "@radix-ui/react-progress": "^1.1.0",
        "@radix-ui/react-radio-group": "^1.2.1",
        "@radix-ui/react-scroll-area": "^1.2.1",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.1",
        "@radix-ui/react-tabs": "^1.1.1",
        "@radix-ui/react-tooltip": "^1.1.4",
        "@simplewebauthn/browser": "^11.0.0",
        "@simplewebauthn/server": "^11.0.0",
        "@tanstack/react-table": "^8.20.5",
        "class-variance-authority": "^0.7.0",
        "cli-table3": "^0.6.5",
        "cmdk": "^1.0.4",
        "consola": "^3.2.3",
        "input-otp": "^1.4.1",
        "jose": "^5.9.6",
        "jsx-email": "^2.1.5",
        "kysely": "^0.27.4",
        "lucide-react": "^0.460.0",
        "make-dir": "^5.0.0",
        "nanostores": "^0.11.3",
        "next-themes": "^0.4.3",
        "nodemailer": "^6.9.16",
        "nuqs": "^2.2.1",
        "ofetch": "^1.4.1",
        "otpauth": "^9.3.5",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-error-boundary": "^4.1.2",
        "react-hook-form": "^7.53.2",
        "react-router-dom": "^6.28.0",
        "redactyl.js": "^1.6.0",
        "sonner": "^1.7.0",
        "std-env": "^3.8.0",
        "typeid-js": "^1.1.0",
        "ua-parser-js": "^2.0.0",
        "unstorage": "^1.13.1",
        "uqr": "^0.1.2",
        "vaul": "^1.1.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@simplewebauthn/typescript-types": "^8.3.4",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@types/nodemailer": "^6.4.17",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "@types/ua-parser-js": "^0.7.39",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "chalk": "^5.3.0",
        "citty": "^0.1.6",
        "clsx": "^2.1.1",
        "dotenv": "^16.4.5",
        "git-cliff": "^2.6.1",
        "lefthook": "^1.8.4",
        "nitropack": "^2.10.4",
        "npm-check-updates": "^17.1.11",
        "postcss": "^8.4.49",
        "strip-ansi": "^7.1.0",
        "tailwind-debug-breakpoints": "^1.0.3",
        "tailwind-merge": "^2.5.4",
        "tailwindcss": "^3.4.15",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-motion": "^0.2.7",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vite-tsconfig-paths": "^5.1.3"
    },
    "packageManager": "pnpm@9.14.1"
}
