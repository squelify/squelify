{
    "name": "nitro-app",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riipandi/nitro-stack.git"
    },
    "bugs": {
        "url": "https://github.com/riipandi/nitro-stack/issues"
    },
    "homepage": "https://github.com/riipandi/nitro-stack#readme",
    "scripts": {
        "dev": "nitro dev",
        "build": "nitro build",
        "preview": "node .output/server/index.mjs",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "prepare": "nitro prepare",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "cleanup": "pnpm run --stream --color \"/cleanup:/\"",
        "cleanup:dev": "pnpm dlx rimraf .output .data .nitro .wrangler dist",
        "cleanup:test": "pnpm dlx rimraf tests-results playwright-report",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules",
        "changelog:full": "git-cliff -o CHANGELOG.md -c cliff-full.toml",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "redactyl.js": "^1.6.0",
        "std-env": "^3.7.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "git-cliff": "^2.6.1",
        "lefthook": "^1.7.22",
        "nitropack": "^2.9.7",
        "npm-check-updates": "^17.1.4",
        "typescript": "^5.6.3"
    },
    "packageManager": "pnpm@9.12.2"
}
