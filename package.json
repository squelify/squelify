{
    "name": "ntrl",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riipandi/ntrl.git"
    },
    "bugs": {
        "url": "https://github.com/riipandi/ntrl/issues"
    },
    "homepage": "https://github.com/riipandi/ntrl#readme",
    "scripts": {
        "dev": "nitro dev",
        "build": "pnpm --silent run build:vite && pnpm --silent run build:nitro",
        "build:nitro": "nitro build",
        "build:vite": "vite build",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "prepare": "nitro prepare",
        "start": "node --env-file .env .output/server/index.mjs",
        "db:make-migration": "tsx -r dotenv/config ./server/database/migratectl/cli.ts make-migration",
        "db:make-seeder": "tsx -r dotenv/config ./server/database/migratectl/cli.ts make-seeder",
        "db:migrate": "tsx -r dotenv/config ./server/database/migratectl/cli.ts migrate",
        "db:reset": "tsx -r dotenv/config ./server/database/migratectl/cli.ts reset",
        "db:rollback": "tsx -r dotenv/config ./server/database/migratectl/cli.ts rollback",
        "db:seed": "tsx -r dotenv/config ./server/database/migratectl/cli.ts seed",
        "db:generate": "tsx -r dotenv/config ./server/database/migratectl/cli.ts generate",
        "docker:build": "docker build -f Dockerfile . -t $npm_package_name:latest -t $npm_package_name:$npm_package_version",
        "docker:images": "docker image list --filter reference=$npm_package_name:$npm_package_version --filter reference=$npm_package_name:latest",
        "docker:run": "pnpm --silent run dockerx --name $npm_package_name $npm_package_name:$npm_package_version",
        "docker:shell": "pnpm --silent run dockerx --entrypoint /bin/sh $npm_package_name:$npm_package_version",
        "dockerx": "docker run --network=host --rm -it --env-file .env -v $(pwd)/_data:/srv/_data",
        "compose:up": "docker compose up --detach --remove-orphans",
        "compose:down": "docker compose down --remove-orphans",
        "compose:cleanup": "docker compose down --remove-orphans --volumes",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "cleanup": "pnpm run --stream --color \"/cleanup:/\"",
        "cleanup:dev": "pnpm dlx rimraf .{output,client,data,nitro,wrangler} _data dist",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules .nitro",
        "cleanup:test": "pnpm dlx rimraf tests-results playwright-report",
        "changelog:full": "git-cliff -o CHANGELOG.md -c cliff-full.toml",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.9.0",
        "@libsql/kysely-libsql": "^0.4.1",
        "@nanostores/persistent": "^0.10.2",
        "@nanostores/react": "^0.8.0",
        "@node-rs/argon2": "^2.0.0",
        "@radix-ui/react-accordion": "^1.2.1",
        "@radix-ui/react-alert-dialog": "^1.1.2",
        "@radix-ui/react-aspect-ratio": "^1.1.0",
        "@radix-ui/react-avatar": "^1.1.1",
        "@radix-ui/react-checkbox": "^1.1.2",
        "@radix-ui/react-collapsible": "^1.1.1",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-dropdown-menu": "^2.1.2",
        "@radix-ui/react-icons": "^1.3.0",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-popover": "^1.1.2",
        "@radix-ui/react-progress": "^1.1.0",
        "@radix-ui/react-radio-group": "^1.2.1",
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.1",
        "@radix-ui/react-tabs": "^1.1.1",
        "@radix-ui/react-tooltip": "^1.1.3",
        "class-variance-authority": "^0.7.0",
        "consola": "^3.2.3",
        "input-otp": "^1.2.4",
        "jose": "^5.9.6",
        "jsx-email": "^2.0.11",
        "kysely": "^0.27.4",
        "lucide-react": "^0.453.0",
        "nanostores": "^0.11.3",
        "next-themes": "^0.3.0",
        "nodemailer": "^6.9.15",
        "ofetch": "^1.4.1",
        "react-cookie": "^7.2.1",
        "react-dom": "^18.3.1",
        "react-error-boundary": "^4.1.2",
        "react-hook-form": "^7.53.1",
        "react-router-dom": "^6.27.0",
        "react": "^18.3.1",
        "redactyl.js": "^1.6.0",
        "sonner": "^1.5.0",
        "std-env": "^3.7.0",
        "typeid-js": "^1.1.0",
        "ua-parser-js": "^1.0.39",
        "universal-cookie": "^7.2.1",
        "vaul": "^1.1.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@types/nodemailer": "^6.4.16",
        "@types/react-dom": "^18.3.1",
        "@types/react": "^18.3.12",
        "@types/ua-parser-js": "^0.7.39",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "clsx": "^2.1.1",
        "dotenv": "^16.4.5",
        "git-cliff": "^2.6.1",
        "lefthook": "^1.8.1",
        "nitropack": "^2.9.7",
        "npm-check-updates": "^17.1.4",
        "postcss": "^8.4.47",
        "tailwind-debug-breakpoints": "^1.0.3",
        "tailwind-merge": "^2.5.4",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-motion": "0.3.0-beta",
        "tailwindcss": "^3.4.14",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3",
        "vite-plugin-inspect": "^0.8.7",
        "vite-tsconfig-paths": "^5.0.1",
        "vite": "^5.4.10"
    },
    "packageManager": "pnpm@9.12.2"
}
