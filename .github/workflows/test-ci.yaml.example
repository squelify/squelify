on: [push]

name: Integration Test

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: ./.github/actions/pnpm
      - run: pnpm lint

  test:
    name: Test
    runs-on: ubuntu-latest
    services:
      libsql:
        image: ghcr.io/tursodatabase/libsql-server:latest
        ports:
          - 5001:5001
          - 8080:8080
          - 8081:8081
      valkey:
        image: valkey/valkey:8-bookworm
        ports:
          - 6379:6379
    steps:
      - uses: actions/checkout@v3
      - uses: ./.github/actions/pnpm
      - run: echo "pnpm test"

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, test]
    steps:
      - uses: actions/checkout@v3
      - uses: ./.github/actions/pnpm
      - run: pnpm build
